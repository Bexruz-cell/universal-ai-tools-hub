{
  "$schema": "https://antigravity.google/schemas/plugin.json",
  "name": "omnitools-bridge",
  "version": "1.0.0",
  "displayName": "OmniTools Universal AI Bridge",
  "description": "Universal AI tool bridge for Antigravity, Claude, and ChatGPT / Codex. Provides web scraping, YouTube transcripts, crypto & forex data, and 2026 curated catalog.",
  "author": "Bexruz stark (@Bexruz-cell)",
  "skills": [
    "skills/omnitools-bridge",
    "plugins/omnitools-bridge/skills/deep-search",
    "plugins/omnitools-bridge/skills/scrape-web",
    "plugins/omnitools-bridge/skills/youtube-transcript",
    "plugins/omnitools-bridge/skills/calc-expression",
    "plugins/omnitools-bridge/skills/crypto-price"
  ],
  "mcpServers": {
    "omnitools-mcp": {
      "command": "python",
      "args": [
        "src/adapters/mcp_adapter.py"
      ]
    }
  }
}
